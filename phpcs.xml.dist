<?xml version="1.0"?>
<ruleset name="WP FSE Boilerplate">
	<description>Coding standards for the WP FSE boilerplate theme.</description>

	<!-- Paths scanned -->
	<file>wp-content/themes/theme-fse/</file>

	<!-- Exclusions -->
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/_dev/node_modules/*</exclude-pattern>

	<!-- CLI args -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- Main ruleset -->
	<rule ref="WordPress-Extra"/>

	<!-- Text-domain (currently fse-boilerplate; will change to studioval-boilerplate in Batch 4) -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="fse-boilerplate"/>
			</property>
		</properties>
	</rule>

	<!-- PHP compatibility target -->
	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Minimum supported WordPress version -->
	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
