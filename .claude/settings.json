{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(ddev:*)",
      "Bash(wp:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -v)",
      "Bash(git fetch)",
      "Bash(git fetch:*)",
      "Bash(git remote -v)",
      "Bash(git blame:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(php --version)",
      "Bash(php -v)",
      "Bash(node --version)",
      "Bash(node -v)",
      "Bash(npm --version)",
      "Bash(composer --version)",
      "Bash(ddev --version)"
    ],
    "deny": [
      "Edit(wp-config.php)",
      "Edit(wp-config-ddev.php)",
      "Edit(wp-config-sample.php)",
      "Edit(auth.json)",
      "Edit(wp-admin/**)",
      "Edit(wp-includes/**)",
      "Edit(vendor/**)",
      "Edit(**/node_modules/**)",
      "Edit(wp-content/themes/theme-fse/dist/**)",
      "Write(wp-config.php)",
      "Write(auth.json)",
      "Write(wp-admin/**)",
      "Write(wp-includes/**)",
      "Write(vendor/**)",
      "Write(**/node_modules/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)"
    ]
  }
}
