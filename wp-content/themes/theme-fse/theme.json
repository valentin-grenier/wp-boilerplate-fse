{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"useRootPaddingAwareAlignments": false,
		"appearanceTools": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1140px",
			"allowCustomContentAndWideSize": false,
			"allowEditing": false
		},
		"color": {
			"text": false,
			"background": false,
			"link": false,
			"caption": false,
			"button": false,
			"heading": false,
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#4D65C7"
				},
				{
					"name": "Primary Alt",
					"slug": "primary-alt",
					"color": "#425391"
				},
				{
					"name": "Dark",
					"slug": "dark",
					"color": "#232A43"
				},
				{
					"name": "Light",
					"slug": "light",
					"color": "#F4F4F9"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#ffffff"
				}
			]
		},
		"spacing": {
			"blockGap": false,
			"customSpacingSize": false,
			"margin": false,
			"padding": false,
			"units": ["px", "rem", "%", "dvh", "dvw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Très petit",
					"size": "1rem",
					"slug": "xs"
				},
				{
					"name": "Petit",
					"size": "1.5rem",
					"slug": "sm"
				},
				{
					"name": "Moyen",
					"size": "2rem",
					"slug": "md"
				},
				{
					"name": "Grand",
					"size": "4rem",
					"slug": "lg"
				},
				{
					"name": "Très grand",
					"size": "8rem",
					"slug": "xl"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": false,
			"fontWeight": false,
			"letterSpacing": false,
			"lineHeight": false,
			"textAlign": false,
			"textColumns": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"fontFamily": "'Poppins', sans-serif",
					"name": "Poppins",
					"slug": "primary",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": ["file:./dist/assets/fonts/Poppins-Regular.woff2"]
						},
						{
							"fontFamily": "Poppins",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": ["file:./dist/assets/fonts/Poppins-SemiBold.woff2"]
						},
						{
							"fontFamily": "Poppins",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": ["file:./dist/assets/fonts/Poppins-Bold.woff2"]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Petit",
					"size": "0.88rem",
					"slug": "sm",
					"fluid": {
						"min": "",
						"max": ""
					}
				},
				{
					"name": "Moyen",
					"size": "1.125rem",
					"slug": "md",
					"fluid": {
						"min": "",
						"max": ""
					}
				},
				{
					"name": "Grand",
					"size": "1.5rem",
					"slug": "lg",
					"fluid": {
						"min": "",
						"max": ""
					}
				},
				{
					"name": "Très Grand",
					"size": "2rem",
					"slug": "xl",
					"fluid": {
						"min": "",
						"max": ""
					}
				},
				{
					"name": "Énorme",
					"size": "2.5rem",
					"slug": "xxl",
					"fluid": {
						"min": "",
						"max": ""
					}
				}
			]
		},
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"background": {
			"backgroundImage": false,
			"backgroundSize": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Douce",
					"slug": "light",
					"shadow": "rgba(100, 100, 111, 0.2) 0px 7px 29px 0px"
				},
				{
					"name": "Fine",
					"slug": "neat",
					"shadow": "rgba(99, 99, 99, 0.4) 0px 2px 8px 0px"
				},
				{
					"name": "Imposante",
					"slug": "huge",
					"shadow": "rgba(255, 255, 255, 0.1) 0px 1px 1px 0px inset, rgba(50, 50, 93, 0.25) 0px 50px 100px -20px, rgba(0, 0, 0, 0.3) 0px 30px 60px -30px"
				}
			]
		},
		"dimensions": {
			"aspectRatio": false,
			"defaultAspectRatios": false,
			"minHeight": false
		},
		"position": {
			"sticky": false
		},
		"custom": {
			"fontWeight": {},
			"lineHeight": {},
			"radius": {},
			"color": {}
		},
		"blocks": {
			"core/image": {
				"lightbox": {
					"enabled": false,
					"allowEditing": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--dark)",
			"background": "var(--wp--preset--color--white)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--md)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"color": {
					"text": "var(--wp--preset--color--white)",
					"background": "var(--wp--preset--color--dark)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--sm)",
						"right": "var(--wp--preset--spacing--md)",
						"bottom": "var(--wp--preset--spacing--sm)",
						"left": "var(--wp--preset--spacing--md)"
					}
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--white)",
						"background": "var(--wp--preset--color--primary-alt)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--white)",
						"background": "var(--wp--preset--color--primary-alt)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--dark)"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxl)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lg)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--md)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--md)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--dark)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-alt)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--primary-alt)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--primary-alt)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)"
				}
			}
		},
		"blocks": {
			"core/template-part": {
				"spacing": {
					"margin": {
						"top": "0 !important"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},

		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-full-width",
			"title": "Page pleine largeur, sans titre",
			"postTypes": ["page"]
		}
	]
}
