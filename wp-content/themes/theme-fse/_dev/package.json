	"scripts": {
		"dev": "webpack --config webpack.dev.js",
		"build": "webpack --config webpack.prod.js",
		"make-block": "node scripts/make-block.js",
		"lint:js": "eslint \"js/**/*.js\" \"blocks/**/*.js\"",
		"lint:js:fix": "eslint \"js/**/*.js\" \"blocks/**/*.js\" --fix",
		"lint:css": "stylelint \"scss/**/*.scss\" \"blocks/**/*.scss\"",
		"lint:css:fix": "stylelint \"scss/**/*.scss\" \"blocks/**/*.scss\" --fix",
		"lint": "npm run lint:js && npm run lint:css",
		"format": "prettier --write \"**/*.{js,json,md,scss}\""
	}
