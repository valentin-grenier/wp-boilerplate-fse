		"autoprefixer": "^10.4.21",
		"babel-loader": "^10.0.0",
		"browser-sync": "^3.0.4",
		"browser-sync-webpack-plugin": "^2.4.0",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^8.0.0",
		"eslint": "^8.57.1",
		"glob": "^13.0.6",
		"mini-css-extract-plugin": "^2.9.2",
		"postcss": "^8.5.14",
		"postcss-loader": "^8.1.1",
		"prettier": "^3.3.3",
