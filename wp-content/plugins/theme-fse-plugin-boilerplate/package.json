{
	"name": "theme-fse-plugin-boilerplate",
	"version": "1.0.0",
	"description": "Blank scaffold for WordPress plugins — Singleton classes, empty React admin page, webpack-built.",
	"private": true,
	"scripts": {
		"dev": "webpack --mode development --watch",
		"build": "webpack --mode production",
		"lint:js": "eslint \"src/js/**/*.js\"",
		"lint:js:fix": "eslint \"src/js/**/*.js\" --fix",
		"lint:css": "stylelint \"src/scss/**/*.scss\"",
		"lint:css:fix": "stylelint \"src/scss/**/*.scss\" --fix",
		"lint": "npm run lint:js && npm run lint:css"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"@babel/preset-react": "^7.24.0",
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/components": "^28.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^5.9.0",
		"@wordpress/element": "^5.33.0",
		"@wordpress/eslint-plugin": "^22.0.0",
		"@wordpress/i18n": "^4.55.0",
		"@wordpress/stylelint-config": "^23.0.0",
		"babel-loader": "^9.1.3",
		"css-loader": "^7.1.0",
		"eslint": "^8.57.1",
		"mini-css-extract-plugin": "^2.9.0",
		"sass": "^1.77.0",
		"sass-loader": "^14.2.0",
		"stylelint": "^16.10.0",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	}
}
