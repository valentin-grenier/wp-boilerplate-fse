# phpstan (PHP Static Analyzer) — logic-bug finder.
#
# What it does:
#   Reads PHP without running it and flags type errors, undefined functions,
#   unreachable code, wrong argument counts, paths that should return a value but
#   don't, etc. Where phpcs checks *style*, phpstan checks *correctness*.
#
# How to run:
#   composer stan
#
# To override locally (not committed):
#   cp phpstan.neon.dist phpstan.neon   # phpstan.neon is gitignored

includes:
    # szepeviktor/phpstan-wordpress teaches phpstan about WP's global API
    # (get_field, add_action, wp_kses_post, $wpdb, hooks, etc.). Without it,
    # nearly every WP call would be flagged as "unknown function".
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    # Levels 0 (loosest) to 9 (max strict). 5 is the sweet spot for WP code: strict
    # enough to catch real bugs, loose enough to not drown you in WP's dynamic-typing
    # noise. Raise one level at a time as the codebase gets cleaner.
    level: 5

    # What to analyze.
    paths:
        - wp-content/themes/theme-fse/
        - wp-content/plugins/theme-fse-plugin-boilerplate/

    # Skip these — compiled output and build-tool sources.
    excludePaths:
        - wp-content/themes/theme-fse/dist/*
        - wp-content/themes/theme-fse/_dev/*
        - wp-content/plugins/theme-fse-plugin-boilerplate/dist/*
        - wp-content/plugins/theme-fse-plugin-boilerplate/node_modules/*

    # Constants whose runtime value phpstan should treat as "unknown string".
    # Without this, phpstan tries to resolve `THEME_FSE_PLUGIN_BOILERPLATE_DIR . 'dist/x.asset.php'`
    # to a literal path and warns when the path doesn't exist — but the actual
    # runtime value depends on plugin_dir_path() and a `file_exists()` guard.
    dynamicConstantNames:
        - THEME_FSE_PLUGIN_BOILERPLATE_VERSION
        - THEME_FSE_PLUGIN_BOILERPLATE_FILE
        - THEME_FSE_PLUGIN_BOILERPLATE_DIR
        - THEME_FSE_PLUGIN_BOILERPLATE_URL

    # Explicit bootstrap (the extension ships one; naming it here makes intent clear
    # and survives future extension updates). The plugin main file registers its
    # define()'d constants here so each `includes/*.php` can reference them
    # without phpstan crying "constant not found".
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
        - wp-content/plugins/theme-fse-plugin-boilerplate/theme-fse-plugin-boilerplate.php
