# CODEOWNERS.template
#
# This file is a TEMPLATE generated by the wp-boilerplate-fse setup script.
# During project setup it is copied to .github/CODEOWNERS in the client repo.
#
# PURPOSE
# -------
# It marks the boilerplate "core" files as owned by @valentin-grenier so that
# GitHub requires a review from the boilerplate maintainer before any pull
# request can modify them. This prevents accidental direct edits to files that
# are managed centrally and synced automatically from the boilerplate.
#
# HOW TO USE
# ----------
# If this file has not been copied automatically by bin/setup.sh, run:
#
#   cp .github/CODEOWNERS.template .github/CODEOWNERS
#
# After copying, feel free to ADD project-specific ownership rules below the
# "Project-specific owners" section. Do NOT remove the core file entries.
#
# More info: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# ── Core boilerplate files (read-only in client projects) ─────────────────
# Any change to these files requires a review from the boilerplate maintainer.
# Fixes must go through https://github.com/valentin-grenier/wp-boilerplate-fse

.claude/agents/wp-reviewer.md        @valentin-grenier
.claude/rules/security.md            @valentin-grenier
.claude/rules/i18n.md                @valentin-grenier
.claude/rules/blocks.md              @valentin-grenier
.claude/hooks/lint-edited.sh         @valentin-grenier
.claude/hooks/session-banner.sh      @valentin-grenier
.claude/hooks/append-lesson.sh       @valentin-grenier
phpcs.xml.dist                       @valentin-grenier
phpstan.neon.dist                    @valentin-grenier
.github/workflows/ci.yml             @valentin-grenier

# ── Project-specific owners ───────────────────────────────────────────────
# Add your own ownership rules here. Example:
# wp-content/themes/my-theme/   @my-github-username
