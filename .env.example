# .env.example
# Copy to .env (gitignored) and fill in for local overrides.
# Most runtime config is handled by DDEV (.ddev/config.yaml) and wp-config-ddev.php;
# this file is a reference for optional values consumed by scripts and CI.

# WordPress
WP_ENV=development            # development | staging | production
WP_DEBUG=true
WP_SITEURL=https://wp-boilerplate-fse.ddev.site

# ACF Pro
# The setup script prefers auth.json (see auth.json.example). This is a fallback.
ACF_PRO_LICENSE=

# Claude Code MCP (optional — see .mcp.json)
NOTION_TOKEN=

# GitHub (for bin/setup-branch-protection.sh — uses gh CLI, not this value directly)
GITHUB_REPO=valentin-grenier/wp-boilerplate-fse
